# EventSnap Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Supabase (required for production) ───────────────────────────────────────
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── App Config ───────────────────────────────────────────────────────────────
VITE_APP_NAME=EventSnap
VITE_APP_URL=http://localhost:5173

# ─── Notes ────────────────────────────────────────────────────────────────────
# Without Supabase env vars, the app runs in "mock mode" using demo data.
# All features work with mock data — no backend needed for Phase 1.
#
# For Google OAuth:
# 1. Create a Google Cloud project
# 2. Enable Google OAuth 2.0
# 3. Add redirect URI: https://your-project.supabase.co/auth/v1/callback
# 4. Add your Client ID/Secret in Supabase Auth → Providers → Google
